  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "pixi.js": "8.12.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
