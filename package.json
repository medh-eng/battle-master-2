{
  "name": "battle-master-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=./ && node scripts/standalone.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
